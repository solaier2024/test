{
  "name": "el-bandido-manco",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",

    "clips": "node scripts/build-clips.mjs",
    "fetch": "node scripts/fetch-generated.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:mobile": "node scripts/shots-mobile.mjs",
    "demo": "node scripts/record-demo.mjs",

    "//verify": "Everything a change has to survive. Run it before pushing.",
    "verify": "npm run lint && npm test && npm run verify:window && npm run verify:lock && npm run verify:identity && npm run verify:budget",
    "verify:window": "node scripts/verify-window.mjs",
    "verify:lock": "node scripts/verify-lock.mjs",
    "verify:identity": "node scripts/verify-identity.mjs",
    "verify:budget": "node scripts/verify-budget.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",

    "//odds": "The engine is TypeScript and the scripts import it directly rather than keeping a second copy of the bands. Node 22.14 needs to be told to strip the types; 22.18 and up does it unasked.",
    "odds": "node --experimental-strip-types scripts/odds.mjs"
  },
  "dependencies": {
    "@fontsource/rye": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
